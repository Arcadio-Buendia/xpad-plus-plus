{
  "name": "sticky-notes-canvas",
  "version": "1.1.1",
  "description": "Xpad-style sticky notes on a transparent desktop canvas",
  "main": "main.js",
  "private": true,
  "homepage": "https://github.com/arcadio-buendia/xpad-plus-plus",
  "author": "arcadio-buendia",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/system-fonts.test.mjs tests/xpad-ui.test.mjs tests/note-geometry.test.mjs tests/single-instance.test.mjs",
    "test:e2e": "node --test tests-e2e/*.e2e.mjs",
    "build:icons": "node build-icons.mjs",
    "build": "electron-builder",
    "build:linux": "electron-builder --linux",
    "build:mac": "electron-builder --mac",
    "build:ui": "node scripts/build-xpad.cjs",
    "prestart": "npm run build:ui",
    "prebuild": "npm run build:ui",
    "prebuild:linux": "npm run build:ui",
    "prebuild:mac": "npm run build:ui",
    "test:upstream": "node --test tests/*.test.mjs",
    "pretest": "npm run build:ui",
    "build:desktop": "npm run build -- --linux --dir --config.electronDist=node_modules/electron/dist"
  },
  "devDependencies": {
    "electron": "^32.0.0",
    "electron-builder": "^25.0.0",
    "sharp": "^0.33.0"
  },
  "build": {
    "appId": "com.local.sticky-notes",
    "productName": "xpad++",
    "files": [
      "main.js",
      "preload.js",
      "storage.js",
      "window-state.js",
      "index.html",
      "app.jsx",
      "components.jsx",
      "hooks.jsx",
      "utils.jsx",
      "vendor/**",
      "assets/**",
      "build/icon.png",
      "build/icons/**",
      "package.json",
      "xpad.jsx",
      "xpad.css",
      "xpad.js",
      "system-fonts.js",
      "note-geometry.js",
      "single-instance.js"
    ],
    "asarUnpack": [
      "build/icon.png",
      "build/icons/**"
    ],
    "linux": {
      "target": [
        "deb",
        "AppImage",
        "snap"
      ],
      "category": "Utility",
      "icon": "build/icons",
      "synopsis": "Xpad-style transparent sticky notes canvas",
      "description": "Xpad-style sticky notes on a transparent desktop canvas, with persistent layouts, system fonts, and inherited note appearance.",
      "desktop": {
        "StartupWMClass": "sticky-notes"
      }
    },
    "snap": {
      "grade": "stable",
      "confinement": "strict",
      "summary": "Spatial sticky notes canvas for Linux",
      "category": "productivity"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "icon": "build/icon.png",
      "identity": null
    },
    "deb": {
      "afterInstall": "build/after-install.sh",
      "afterRemove": "build/after-remove.sh"
    },
    "directories": {
      "output": "dist"
    },
    "executableName": "sticky-notes-canvas"
  },
  "contributors": [
    "faridjaff (original StickyNotesCanvas project)"
  ],
  "engines": {
    "node": ">=22"
  }
}
